# Database
# PostgreSQL 데이터베이스 연결 URL
# 형식: postgresql://사용자명:비밀번호@호스트:포트/데이터베이스명?schema=public
DATABASE_URL="postgresql://test_board_user:test_board_password@localhost:5432/test_board_db?schema=public"

# JWT Secret
# JWT 토큰 서명에 사용되는 비밀키 (프로덕션에서는 반드시 변경하세요)
JWT_SECRET="your-secret-key-change-this-in-production"

# Next.js
NEXTAUTH_URL="http://localhost:3000"

# Email SMTP Settings (선택사항 - 이메일 인증 기능 사용 시에만 필요)
# Gmail 사용 예시:
# 1. Gmail 2단계 인증 활성화: https://myaccount.google.com/
# 2. 앱 비밀번호 생성: https://myaccount.google.com/apppasswords
# 3. 아래 값들을 실제 값으로 변경하세요
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-digit-app-password"
SMTP_FROM="your-email@gmail.com"

# 네이버 지도 (/map 쿠지샵 지도)
# 네이버 클라우드 플랫폼 > Application > Maps > Web Dynamic Map 에서 발급.
# 소셜 로그인용 NAVER_CLIENT_ID 와는 다른 값이고, 콘솔에 서비스 URL
# (예: http://localhost:3000, https://<배포도메인>)을 등록해야 인증이 통과한다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=""
# 2024년 이전에 발급받은 키라면 "ncpClientId" 로 바꿔야 한다. (기본: ncpKeyId)
# NEXT_PUBLIC_NAVER_MAP_KEY_PARAM="ncpKeyId"
